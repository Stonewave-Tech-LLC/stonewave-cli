# Stonewave CLI installer for one user (Windows PowerShell 5.1 or newer). No administrator rights.
#
#   irm https://stonewavetech.com/cli/install.ps1 | iex
#   & ([scriptblock]::Create((irm https://stonewavetech.com/cli/install.ps1))) -Version 0.2.0 -NoPath
#
# Short on purpose, so you can read it before running it. It:
#   1. downloads the manifest of the newest release over HTTPS (TLS 1.2 or better),
#   2. downloads stonewave.exe and checks it against the manifest: size and SHA-256, and the Authenticode signature, which must be valid and
#      made for exactly the subject "Stonewave Tech LLC, Sheridan, Wyoming, US" by a certificate that was issued under the Microsoft
#      authority pinned below (Azure signing certificates last three days, so the authority is pinned, not the certificate),
#   3. runs the downloaded program once with --version, which must say what the manifest says,
#   4. puts it into %LOCALAPPDATA%\Stonewave\bin\stonewave.exe (a running older copy is renamed aside, not killed),
#   5. adds that folder to YOUR user PATH and says so (not with -NoPath).
#
# Parameters:
#   -Version X.Y.Z   install exactly this release (also an older one). Without it: the newest, and never an older one than you have.
#   -NoPath          do not touch PATH
#   -DryRun          download and check everything, install nothing
#   -BinDir DIR      install here instead of %LOCALAPPDATA%\Stonewave\bin
#   -FromDir DIR     take manifest and program from this folder instead of the internet (same checks): for tests and offline installs
# The whole installer is one script block (`& { ... } @args`): its functions, its variables, StrictMode and $ErrorActionPreference end with it,
# so `irm | iex` leaves nothing of them in your session. The options reach it through @args (they are read by the block's own param list).
& { # stonewave-installer-begin
param(
    [string]$Version = '',
    [switch]$NoPath,
    [switch]$DryRun,
    [string]$BinDir = '',
    [string]$FromDir = ''
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2

$Base = 'https://stonewavetech.com/cli'
# Who signs the Windows build. Azure Artifact Signing makes a new certificate every few days (each valid for three days; the signature stays
# valid because it is timestamped), so a certificate's own thumbprint cannot be pinned for good. Pinned instead, all of it required:
#   - the exact subject of the signer certificate,
#   - the thumbprint of the authority that issued it ("Microsoft ID Verified Code Signing PCA 2021"; written in when the release is made,
#     scripts/release-bundle.sh): it must be an intermediate of the certificate's chain (between the certificate and the root), which Windows
#     builds up to a trusted root and checks for revocation,
#   - Windows' own verdict on the signature (Valid), and the SHA-256 of the manifest.
$SignerSubject = 'CN=Stonewave Tech LLC, O=Stonewave Tech LLC, L=Sheridan, S=Wyoming, C=US'
$SignerCaThumbprints = '@WIN_CA_THUMBPRINTS@'
# Release 0.2.0 was signed before the authority was pinned: its certificate is pinned by its own thumbprint, for that release only.
$LegacyLeaf = @{ '0.2.0' = '8A69FFDF224024FD656E942B043D92D5AA381505' }

function Say([string]$Text) { Write-Host "  $Text" }
function Fail([string]$Text) { throw "stonewave install: $Text" }

# ---------------------------------------------------------------- the manifest

# What came from outside must look exactly like what we expect before it is used in a path or a command.
function Read-Manifest([string]$Path, [string]$Target) {
    $lines = @(Get-Content -LiteralPath $Path)
    if ($lines.Count -lt 3 -or $lines[0].Trim() -ne 'stonewave-manifest 1') { Fail 'the manifest is not in a format this installer knows' }
    $m = @{ Version = ''; Commit = ''; File = ''; Sha = ''; Size = '' }
    foreach ($line in $lines) {
        $w = @($line -split '\s+' | Where-Object { $_ -ne '' })
        if ($w.Count -ge 2 -and $w[0] -eq 'version') { $m.Version = $w[1] }
        elseif ($w.Count -ge 2 -and $w[0] -eq 'commit') { $m.Commit = $w[1] }
        elseif ($w.Count -ge 5 -and $w[0] -eq 'file' -and $w[1] -eq $Target) { $m.Sha = $w[2]; $m.Size = $w[3]; $m.File = $w[4] }
    }
    if ($m.Version -notmatch '^[0-9]+\.[0-9]+\.[0-9]+$') { Fail 'the manifest has no usable version' }
    if ($m.Commit -notmatch '^[0-9a-f]{7,40}$') { Fail 'the manifest has no usable commit' }
    if ($m.File -eq '') { Fail "release $($m.Version) has no build for $Target" }
    if ($m.Sha -notmatch '^[0-9a-f]{64}$') { Fail "the manifest has no usable checksum for $Target" }
    if ($m.Size -notmatch '^[0-9]{1,12}$') { Fail "the manifest has no usable size for $Target" }
    if ($m.File -ne "stonewave-$($m.Version)-$Target.exe") { Fail "the manifest names $($m.File) for $Target, which does not fit" }
    return $m
}

function Get-Remote([string]$Relative, [string]$Dest) {
    if ($FromDir -ne '') {
        $src = Join-Path $FromDir ($Relative -replace '/', '\')
        if (-not (Test-Path -LiteralPath $src -PathType Leaf)) { Fail "not found in ${FromDir}: $Relative" }
        Copy-Item -LiteralPath $src -Destination $Dest
        return
    }
    # PowerShell 5.1 can start with TLS 1.0 on some systems: TLS 1.2 is ADDED to what is allowed (nothing is taken away, and TLS 1.3 is not
    # forced on a .NET that does not do it well), and the setting is put back afterwards
    $oldProtocol = [Net.ServicePointManager]::SecurityProtocol
    [Net.ServicePointManager]::SecurityProtocol = $oldProtocol -bor [Net.SecurityProtocolType]::Tls12
    $old = $ProgressPreference
    $ProgressPreference = 'SilentlyContinue'
    try {
        Invoke-WebRequest -UseBasicParsing -Uri "$Base/$Relative" -OutFile $Dest -TimeoutSec 300
    } catch {
        Fail "download failed: $Base/$Relative ($($_.Exception.Message))"
    } finally {
        $ProgressPreference = $old
        [Net.ServicePointManager]::SecurityProtocol = $oldProtocol
    }
}

# ---------------------------------------------------------------- the checks

# The certificates a program carries inside its Authenticode signature (the signer's and the authorities above it), read from the PE file's
# certificate table. Windows builds a chain from what it has cached or can fetch (the authority's certificate is fetched from the address in the
# certificate); with these as extra material it can build it on a machine that is offline and has never seen them. They are only candidates: a chain
# still has to be signed link by link up to a root that is in the machine's own store, so this adds no trust. Anything unreadable gives nothing.
function Get-EmbeddedCertificates([string]$Path) {
    try {
        $file = Get-Item -LiteralPath $Path
        if ($file.Length -gt 64MB) { return @() }
        $bytes = [IO.File]::ReadAllBytes($Path)
        $pe = [int][BitConverter]::ToUInt32($bytes, 0x3C)
        if ($pe -lt 64 -or $pe + 24 -gt $bytes.Length -or [Text.Encoding]::ASCII.GetString($bytes, $pe, 2) -ne 'PE') { return @() }
        $opt = $pe + 24
        $magic = [BitConverter]::ToUInt16($bytes, $opt)
        if ($magic -eq 0x20B) { $dirs = $opt + 112 } elseif ($magic -eq 0x10B) { $dirs = $opt + 96 } else { return @() }
        $off = [long][BitConverter]::ToUInt32($bytes, $dirs + 32)       # the fifth data directory: the certificate table (a file offset)
        $size = [long][BitConverter]::ToUInt32($bytes, $dirs + 36)
        if ($off -le 0 -or $size -lt 8 -or $off + $size -gt $bytes.Length) { return @() }
        $len = [long][BitConverter]::ToUInt32($bytes, [int]$off)
        $type = [BitConverter]::ToUInt16($bytes, [int]$off + 6)         # 2: a PKCS #7 signature
        if ($type -ne 2 -or $len -lt 16 -or $len -gt $size) { return @() }
        $der = New-Object byte[] ($len - 8)
        [Array]::Copy($bytes, $off + 8, $der, 0, $len - 8)
        Add-Type -AssemblyName System.Security
        $cms = New-Object System.Security.Cryptography.Pkcs.SignedCms
        $cms.Decode($der)
        return @($cms.Certificates | ForEach-Object { $_ })
    } catch {
        return @()
    }
}

# The chain of a signer certificate, as Windows builds it (up to a trusted root), with its status and the thumbprints from the certificate up.
# The leaf of a short-lived certificate has expired long before anybody installs: the chain is judged as of the time the certificate began,
# when the signature (timestamped, and checked by Windows as Valid) was made. Revocation is asked online; only when the answer cannot be had
# (no network, no list) the check is repeated from what is cached, then without, and then it says so. Anything else wrong ends it.
# -TestOnlyAcceptUntrustedRoot is for the tests (certificates made on the spot have no trusted root); the installer itself never uses it.
function Get-SignerChain([System.Security.Cryptography.X509Certificates.X509Certificate2]$Cert, [switch]$TestOnlyAcceptUntrustedRoot, $Extra = @()) {
    $chain = New-Object System.Security.Cryptography.X509Certificates.X509Chain
    foreach ($c in @($Extra)) { if ($c) { [void]$chain.ChainPolicy.ExtraStore.Add($c) } }
    $chain.ChainPolicy.VerificationTime = $Cert.NotBefore.AddMinutes(1)
    $chain.ChainPolicy.UrlRetrievalTimeout = [TimeSpan]::FromSeconds(20)
    $chain.ChainPolicy.RevocationFlag = [System.Security.Cryptography.X509Certificates.X509RevocationFlag]::ExcludeRoot
    if ($TestOnlyAcceptUntrustedRoot) { $chain.ChainPolicy.VerificationFlags = [System.Security.Cryptography.X509Certificates.X509VerificationFlags]::AllowUnknownCertificateAuthority }
    $ok = $false
    $status = @()
    $warning = ''
    foreach ($mode in 'Online', 'Offline', 'NoCheck') {
        $chain.ChainPolicy.RevocationMode = [System.Security.Cryptography.X509Certificates.X509RevocationMode]$mode
        $ok = $chain.Build($Cert)
        $status = @($chain.ChainStatus | ForEach-Object { $_.Status.ToString() })
        if ($ok) { if ($mode -ne 'Online') { $warning = "revocation of the signing certificate could not be checked ($mode)" }; break }
        $benign = @('RevocationStatusUnknown', 'OfflineRevocation')
        if ($TestOnlyAcceptUntrustedRoot) { $benign += 'UntrustedRoot' }      # reported although accepted
        $other = @($status | Where-Object { $_ -notin $benign })
        if ($other.Count -gt 0) { break }
    }
    $prints = @($chain.ChainElements | ForEach-Object { $_.Certificate.Thumbprint.ToUpperInvariant() })
    return @{ Ok = $ok; Status = ($status -join ', '); Thumbprints = $prints; Warning = $warning }
}

# The pins, on a certificate and its chain: the exact subject, then either the certificate's own thumbprint (only the legacy one of a release)
# or an issuing authority between it and the root of its chain. Returns what it matched, or ends.
function Test-SignerPins($Cert, $Chain, [string]$Subject, [string[]]$CaPins, [string[]]$LeafPins) {
    if ($Cert.Subject -cne $Subject) { Fail "the download is signed by '$($Cert.Subject)', not by '$Subject'. Nothing was installed." }
    $leaf = $Cert.Thumbprint.ToUpperInvariant()
    if (@($LeafPins) -contains $leaf) { return "certificate $leaf" }
    if (-not $Chain.Ok) { Fail "the chain of the signing certificate is not valid ($($Chain.Status)). Nothing was installed." }
    # an authority BETWEEN the certificate and the root: not the certificate itself, and not the root (a root pin would be every certificate
    # under that root, and a made-up two-link chain would put its own root there)
    $n = @($Chain.Thumbprints).Count
    $between = @()
    if ($n -ge 3) { $between = @($Chain.Thumbprints[1..($n - 2)]) }
    foreach ($pin in @($CaPins)) {
        if ($between -contains $pin) { return "issued under $pin" }
    }
    Fail 'the signing certificate was not issued under the authority this installer pins. Nothing was installed.'
}

# Valid signature, for the pinned subject, issued under the pinned authority (or, for one release, by the pinned certificate), or the end.
function Test-StonewaveSignature([string]$Path, [string]$Subject, [string]$CaThumbprints, [string[]]$LeafThumbprints = @(), [switch]$TestOnlyAcceptUntrustedRoot) {
    $ca = @($CaThumbprints -split '[,\s]+' | Where-Object { $_ -match '^[0-9A-Fa-f]{40}$' } | ForEach-Object { $_.ToUpperInvariant() })
    $leaves = @($LeafThumbprints | Where-Object { $_ } | ForEach-Object { $_.ToUpperInvariant() })
    if ($ca.Count -eq 0 -and $leaves.Count -eq 0) {
        Fail 'this installer was not prepared for Windows (no authority pinned). Nothing was installed.'
    }
    $sig = Get-AuthenticodeSignature -FilePath $Path
    if ($sig.Status -ne 'Valid') { Fail "the signature of the download is not valid ($($sig.Status)). Nothing was installed." }
    $cert = $sig.SignerCertificate
    if ($null -eq $cert) { Fail 'the download has no signer certificate. Nothing was installed.' }
    $chain = Get-SignerChain $cert -TestOnlyAcceptUntrustedRoot:$TestOnlyAcceptUntrustedRoot -Extra (Get-EmbeddedCertificates $Path)
    $how = Test-SignerPins $cert $chain $Subject $ca $leaves
    Say "signature ok ($($cert.Subject.Split(',')[0].Substring(3)), $how)"
    if ($chain.Warning) { Say "note: $($chain.Warning)" }
}

# What a program says to --version (an empty text if it cannot be run).
function Get-BinaryVersion([string]$Path) {
    try {
        $out = & $Path --version 2>$null
        return ((@($out) | Select-Object -First 1) -as [string]).Trim()
    } catch {
        return ''
    }
}

function Test-Older([string]$A, [string]$B) { return ([version]$A) -lt ([version]$B) }

# ---------------------------------------------------------------- PATH (the user's own, not the machine's)

# Adds a folder to the USER path in the registry. The old value is read without expanding %VARIABLES% and written back as an expandable
# string, so what was in it stays as it was. Returns $true when it changed something.
function Add-ToUserPath([string]$Dir, [string]$SubKey = 'Environment') {
    $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey($SubKey, $true)
    if ($null -eq $key) { Fail "cannot open HKCU\$SubKey" }
    try {
        $old = [string]$key.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
        $want = $Dir.TrimEnd('\')
        foreach ($e in ($old -split ';')) {
            # an entry may be written with %LOCALAPPDATA% and the like: it is compared as it reads once expanded
            $here = [Environment]::ExpandEnvironmentVariables($e.Trim()).TrimEnd('\')
            if ($here -ieq [Environment]::ExpandEnvironmentVariables($want)) { return $false }
        }
        $new = if ($old.Trim() -eq '') { $Dir } else { $old.TrimEnd(';') + ';' + $Dir }
        $key.SetValue('Path', $new, [Microsoft.Win32.RegistryValueKind]::ExpandString)
    } finally {
        $key.Close()
    }
    if ($SubKey -eq 'Environment') {
        # setting and removing a variable makes Windows tell running programs that the environment changed
        [Environment]::SetEnvironmentVariable('STONEWAVE_PATH_CHANGED', '1', 'User')
        [Environment]::SetEnvironmentVariable('STONEWAVE_PATH_CHANGED', $null, 'User')
    }
    return $true
}

# ---------------------------------------------------------------- the whole thing

function Install-Stonewave {
    if ($Version -ne '' -and $Version -notmatch '^[0-9]+\.[0-9]+\.[0-9]+$') { Fail '-Version must look like 0.2.0' }
    if (-not [Environment]::Is64BitOperatingSystem) { Fail 'this needs a 64-bit Windows' }
    $target = 'x86_64-windows'
    $bin = $BinDir
    if ($bin -eq '') { $bin = Join-Path $env:LOCALAPPDATA 'Stonewave\bin' }
    if (-not [IO.Path]::IsPathRooted($bin)) { Fail '-BinDir must be a full path' }
    Say "Stonewave CLI installer: $target, into $bin"
    New-Item -ItemType Directory -Force -Path $bin | Out-Null
    $tmp = Join-Path $bin ('.stonewave-install.' + [Guid]::NewGuid().ToString('N').Substring(0, 8))
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null
    try {
        if ($Version -ne '') { Get-Remote "$Version/manifest.txt" (Join-Path $tmp 'manifest.txt') }
        else { Get-Remote 'latest/manifest.txt' (Join-Path $tmp 'manifest.txt') }
        $m = Read-Manifest (Join-Path $tmp 'manifest.txt') $target
        if ($Version -ne '' -and $m.Version -ne $Version) { Fail "asked for $Version, the manifest is for $($m.Version)" }
        Say "release   $($m.Version) ($($m.Commit))"

        $exe = Join-Path $bin 'stonewave.exe'
        $want = "stonewave $($m.Version) ($($m.Commit))"
        $installedLine = ''
        if (Test-Path -LiteralPath $exe -PathType Leaf) {
            $installedLine = Get-BinaryVersion $exe
            if ($installedLine -match '^stonewave ([0-9]+\.[0-9]+\.[0-9]+)') {
                Say "installed  $installedLine"
                if ($Version -eq '') {
                    if (Test-Older $m.Version $Matches[1]) { Fail "you have $($Matches[1]), which is newer than the latest release $($m.Version). To go back, say so: -Version $($m.Version)" }
                    if ($installedLine -eq $want) {
                        Say 'already up to date'
                        Show-PathHelp $bin
                        return
                    }
                }
            }
        }

        $file = Join-Path $tmp $m.File
        Say "downloading $($m.File)"
        Get-Remote "$($m.Version)/$($m.File)" $file
        $size = (Get-Item -LiteralPath $file).Length
        if ([string]$size -ne $m.Size) { Fail "the size is $size, the manifest says $($m.Size). Nothing was installed." }
        $hash = (Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant()
        Say "sha256    $hash"
        if ($hash -ne $m.Sha) { Fail "the checksum does not match the manifest ($($m.Sha)). Nothing was installed." }
        Say 'checksum ok'
        $legacy = @()
        if ($LegacyLeaf.ContainsKey($m.Version)) { $legacy = @($LegacyLeaf[$m.Version]) }
        Test-StonewaveSignature $file $SignerSubject $SignerCaThumbprints $legacy
        # the program has been checked: now it may run once, to say who it is
        $ran = Get-BinaryVersion $file
        if ($ran -ne $want) { Fail "the program says '$ran', not '$want'. Nothing was installed." }
        Say "runs      $ran"

        if ($DryRun) { Say "dry run: would install $exe"; return }
        # a running older copy cannot be overwritten, but it can be renamed: it keeps running, the new one takes its place
        $aside = $null
        if (Test-Path -LiteralPath $exe) {
            $aside = "$exe.old-$PID"
            Move-Item -LiteralPath $exe -Destination $aside -Force
        }
        try {
            Move-Item -LiteralPath $file -Destination $exe -Force
        } catch {
            if ($aside) { Move-Item -LiteralPath $aside -Destination $exe -Force }
            Fail "cannot put $exe in place: $($_.Exception.Message)"
        }
        if ($aside) { Remove-Item -LiteralPath $aside -Force -ErrorAction SilentlyContinue }
        Get-ChildItem -LiteralPath $bin -Filter 'stonewave.exe.old-*' -ErrorAction SilentlyContinue | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }
        Say "installed $exe"
        Show-PathHelp $bin
        Say 'next: stonewave          (the menu)     stonewave doctor     (a read-only check)'
    } finally {
        Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
    }
}

function Show-PathHelp([string]$Bin) {
    $here = @(($env:Path -split ';') | ForEach-Object { $_.Trim().TrimEnd('\') })
    if ($here -icontains $Bin.TrimEnd('\')) { return }
    if ($NoPath -or $DryRun) {
        Say "$Bin is not on your PATH; run $Bin\stonewave.exe or add the folder yourself"
        return
    }
    if (Add-ToUserPath $Bin) {
        Say "added $Bin to your user PATH (not the machine's). Open a new terminal to use 'stonewave' by name."
    } else {
        Say "$Bin is already in your user PATH. Open a new terminal to use 'stonewave' by name."
    }
    $env:Path = $env:Path.TrimEnd(';') + ';' + $Bin
}

# Running or piping this file installs: the whole file is one `& { ... } @args` block. Only the tests dot-source what is INSIDE the block (they cut
# off the first and the last line, marked stonewave-installer-begin / -end): then this guard sees `.` and the functions are only defined.
if ($MyInvocation.InvocationName -ne '.') {
    try {
        Install-Stonewave
    } catch {
        Write-Host ('  ' + $_.Exception.Message) -ForegroundColor Red
        # `irm | iex` runs in the caller's session: never `exit` there, it would close their window
        $global:LASTEXITCODE = 1
    }
}
} @args # stonewave-installer-end
